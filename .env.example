# Copy to .env and choose ONE option. .env is git-ignored.

# Option 1: Claude (default, paid)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional. Default: claude-opus-5-5
# LLM_MODEL=claude-opus-5-5
# Optional. One of low, medium, high. Default: medium
# LLM_EFFORT=medium

# Option 2: free tier from Google AI Studio (https://aistudio.google.com/apikey)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=

# Option 3: free tier from Groq (https://console.groq.com/keys)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=

# Option 4: local model with Ollama, no key (the model must support tools)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# Optional. Fixes the clock, for reproducible demos and evaluation. Store time.
# AGENT_NOW=2026-02-10T10:30:00
