# Copy to .env. It is git-ignored, so a key here never reaches the repository.

# Gemini is the default: only the key is required (https://aistudio.google.com/apikey)
LLM_API_KEY=
# Optional. Default: gemini-3.8-flash
# LLM_MODEL=gemini-3.8-flash

# Alternative: Claude
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# Optional. Default: claude-opus-5-5
# LLM_MODEL=claude-opus-5-5
# Optional. One of low, medium, high. Default: medium
# LLM_EFFORT=medium

# Alternative: any OpenAI-compatible endpoint. Model names change often, so check the provider's list.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=

# Alternative: local model with Ollama, no key (the model must support tools)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# Optional. Fixes the clock, for reproducible demos and evaluation. Store time.
# AGENT_NOW=2026-02-20T10:00:00

# Optional. Limits for the HTTP API, per instance.
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=300
